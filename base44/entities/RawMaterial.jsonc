{
  "name": "RawMaterial",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the raw material"
    },
    "type": {
      "type": "string",
      "enum": [
        "ethanol",
        "botanical",
        "grain",
        "sugar",
        "water",
        "flavoring",
        "packaging",
        "other"
      ],
      "description": "Type of raw material"
    },
    "quantity": {
      "type": "number",
      "description": "Current quantity in stock"
    },
    "unit": {
      "type": "string",
      "enum": [
        "litres",
        "kg",
        "units"
      ],
      "description": "Unit of measurement"
    },
    "abv_percent": {
      "type": "number",
      "description": "ABV percentage (for ethanol/spirits only)"
    },
    "lals": {
      "type": "number",
      "description": "Litres of Absolute Alcohol (for ethanol/spirits)"
    },
    "supplier": {
      "type": "string",
      "description": "Supplier name"
    },
    "cost_per_unit": {
      "type": "number",
      "description": "Cost per unit"
    },
    "batch_number": {
      "type": "string",
      "description": "Batch or lot number"
    },
    "date_received": {
      "type": "string",
      "format": "date",
      "description": "Date the material was received"
    },
    "receiving_id": {
      "type": "string",
      "description": "ID of the linked Receiving record (for traceability to the packing slip)"
    },
    "lots": {
      "type": "array",
      "description": "Lot/batch history for FIFO tracking. Each entry is a received lot with its remaining quantity.",
      "items": {
        "type": "object",
        "properties": {
          "lot_number": {
            "type": "string"
          },
          "date_received": {
            "type": "string"
          },
          "quantity_received": {
            "type": "number"
          },
          "quantity_remaining": {
            "type": "number"
          },
          "supplier": {
            "type": "string"
          },
          "cost_per_unit": {
            "type": "number"
          },
          "receiving_id": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "name",
    "type",
    "quantity",
    "unit"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}