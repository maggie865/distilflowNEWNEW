{
  "name": "WasteRecord",
  "description": "General waste tracking for BCorp reporting and KPI monitoring",
  "attributes": {
    "date": { "type": "string", "format": "date", "description": "Date waste was disposed" },
    "category": {
      "type": "string",
      "enum": ["general","recycling","glass","cardboard","organic","hazardous","other"],
      "default": "general"
    },
    "bin_size_litres": { "type": "number", "description": "Size of bin used in litres (e.g. 70)" },
    "bins_count": { "type": "number", "description": "Number of bins (can be fractional e.g. 0.5)" },
    "litres": { "type": "number", "description": "Total volume in litres" },
    "kg": { "type": "number", "description": "Weight in kg (actual or estimated from density)" },
    "recorded_by": { "type": "string" },
    "notes": { "type": "string" }
  },
  "required": ["date", "category"],
  "rls": { "create": {}, "read": {}, "update": {}, "delete": {} }
}
