{
  "name": "WhiskeyBarrel",
  "type": "object",
  "properties": {
    "barrel_number": {
      "type": "string",
      "description": "Company barrel number / identifier"
    },
    "product_name": {
      "type": "string",
      "description": "Name of the spirit maturing in the barrel"
    },
    "barrel_type": {
      "type": "string",
      "enum": [
        "ex-bourbon",
        "ex-sherry",
        "ex-port",
        "ex-wine",
        "ex-rum",
        "new_oak",
        "charred",
        "other"
      ],
      "default": "ex-bourbon",
      "description": "Type of barrel (wood / previous contents)"
    },
    "capacity_litres": {
      "type": "number",
      "description": "Original full capacity of the barrel in litres"
    },
    "volume_litres": {
      "type": "number",
      "description": "Current volume of spirit in the barrel (litres)"
    },
    "abv_percent": {
      "type": "number",
      "description": "Current ABV % of the spirit"
    },
    "fill_date": {
      "type": "string",
      "format": "date",
      "description": "Date the barrel was filled (used to calculate age)"
    },
    "previous_use": {
      "type": "string",
      "enum": [
        "first_fill",
        "second_fill",
        "third_fill",
        "refill"
      ],
      "description": "Which fill this barrel is on"
    },
    "cooperage": {
      "type": "string",
      "description": "Cooperage / manufacturer of the barrel"
    },
    "owner": {
      "type": "string",
      "description": "Owner of the barrel (if storing for a third party) \u2014 blank if owned by distillery"
    },
    "location_description": {
      "type": "string",
      "description": "Where the barrel is stored in the distillery (e.g. Warehouse A, Rack 3)"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_storage",
        "maturing",
        "emptied",
        "sold",
        "returned",
        "leaking"
      ],
      "default": "maturing",
      "description": "Current status of the barrel"
    },
    "last_checked_date": {
      "type": "string",
      "format": "date",
      "description": "Date the barrel was last inspected / checked"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "barrel_number",
    "product_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}