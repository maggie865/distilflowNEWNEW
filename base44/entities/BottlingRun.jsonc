{
  "name": "BottlingRun",
  "type": "object",
  "properties": {
    "batch_number": {
      "type": "string",
      "description": "Bottling batch number"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of bottling"
    },
    "product_name": {
      "type": "string",
      "description": "Product being bottled"
    },
    "input_volume": {
      "type": "number",
      "description": "Volume of spirit to bottle (litres)"
    },
    "input_abv": {
      "type": "number",
      "description": "ABV of spirit (%)"
    },
    "input_lals": {
      "type": "number",
      "description": "LALs being bottled"
    },
    "bottle_size_ml": {
      "type": "number",
      "description": "Bottle size in ml"
    },
    "bottles_produced": {
      "type": "number",
      "description": "Number of bottles produced"
    },
    "lals_per_bottle": {
      "type": "number",
      "description": "LALs per individual bottle"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "completed"
      ],
      "default": "planned"
    },
    "packaging_costs": {
      "type": "array",
      "description": "Actual FIFO packaging costs captured at time of bottling",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty_used": {
            "type": "number"
          },
          "cost_per_unit": {
            "type": "number"
          },
          "total_cost": {
            "type": "number"
          },
          "lot_number": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "batch_number",
    "date",
    "product_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}