{
  "name": "UtilityLog",
  "type": "object",
  "properties": {
    "period": {
      "type": "string",
      "description": "Billing / reading period (e.g. 2026-07)"
    },
    "reading_date": {
      "type": "string",
      "format": "date",
      "description": "Date the reading was taken / bill covers"
    },
    "electricity_kwh": {
      "type": "number",
      "description": "Electricity consumed from mains grid (kWh)"
    },
    "water_litres": {
      "type": "number",
      "description": "Water consumed from town supply (litres)"
    },
    "electricity_cost": {
      "type": "number",
      "description": "Cost of electricity for the period (NZD)"
    },
    "water_cost": {
      "type": "number",
      "description": "Cost of water for the period (NZD)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "period",
    "reading_date"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}